{
  "name": "@webiny/di",
  "license": "MIT",
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "author": "Webiny Ltd.",
  "keywords": [
    "dependency injection",
    "container",
    "ioc",
    "inversion of control",
    "abstractions",
    "solid",
    "domain driven design"
  ],
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "release": "pnpm run build && changeset publish",
    "lint": "tsc && oxlint --deny-warnings && oxfmt --check",
    "test": "vitest --run --typecheck",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**/**\"",
    "format": "oxfmt",
    "format:fix": "oxfmt",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@rslib/core": "^0.23.2",
    "@rspack/core": "^2.1.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
