{
  "name": "@webiny/di",
  "license": "MIT",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.js",
  "author": "Webiny Ltd.",
  "keywords": [
    "dependency injection",
    "container",
    "ioc",
    "inversion of control",
    "abstractions",
    "solid",
    "domain driven design"
  ],
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "release": "pnpm run build && changeset publish",
    "lint": "tsc && oxlint --deny-warnings && oxfmt --check",
    "prettier": "prettier \"**/**/*.{ts,json}\" --config .prettierrc.json",
    "prettier:fix": "pnpm run prettier --write",
    "prettier:check": "pnpm run prettier --check",
    "test": "vitest --run --typecheck",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**/**\"",
    "format": "oxfmt",
    "format:fix": "oxfmt",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@rslib/core": "^0.21.5",
    "@rspack/core": "^2.0.3",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
