{
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["vitest/globals", "node"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "module": "preserve",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler"
  },
  "include": ["src", "__tests__"]
}
